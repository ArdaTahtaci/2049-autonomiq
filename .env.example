# MachineProof backend configuration. Copy to .env — every value has a working local default.
#
# Public testnet (Sepolia): copy to .env.sepolia instead and fill in RPC_URL, the three keys and
# PAYEE_ADDRESS; `npm run deploy:sepolia` / `npm run dev:sepolia` load only that file. Keep testnet
# keys out of .env: the local Hardhat demo and dev server read .env and need the dev accounts.
# All .env* files except this template are gitignored. On Render, set secrets in the dashboard.

# HTTP port of the backend API (Render injects PORT automatically)
PORT=3000
# Interface to bind; 0.0.0.0 lets a hosting platform route to the server
HOST=0.0.0.0

# JSON-RPC endpoint (local Hardhat node started with `npm run chain`)
RPC_URL=http://127.0.0.1:8545

# Escrow contract address. Leave empty to use deployments/localhost.json written by `npm run deploy`.
ESCROW_ADDRESS=
# Block the escrow was deployed at (printed by `npm run deploy`); event lookups start there
ESCROW_DEPLOY_BLOCK=

# ── Keys ────────────────────────────────────────────────────────────────────────────────────────
# Leave empty to use Hardhat's PUBLIC dev accounts (#0 verifier, #1 requester, #2 robot, #3 payee).
# DEVELOPMENT ONLY: the backend refuses to use those dev keys on any chain other than 31337.
# Never commit real keys.
VERIFIER_PRIVATE_KEY=     # backend oracle: deploys the escrow, commits proofs, settles/refunds
REQUESTER_PRIVATE_KEY=    # funds task escrows (stand-in for the requester's wallet until a frontend exists)
ROBOT_PRIVATE_KEY=        # robot signing identity; used by the mock robot and `npm run robot:submit`

# Robot registry (single robot for the MVP): proofs for ROBOT_ID must be signed by ROBOT_ADDRESS.
# ROBOT_ADDRESS defaults to the address of ROBOT_PRIVATE_KEY.
ROBOT_ID=robot_001
ROBOT_ADDRESS=

# Wallet that receives payment on settlement (defaults to Hardhat account #3)
PAYEE_ADDRESS=

# ── Robotics ────────────────────────────────────────────────────────────────────────────────────
# mock     = backend simulates the robot on POST /tasks/:id/start
# external = real simulator POSTs signed proofs to /tasks/:id/proof (or use `npm run robot:submit`)
ROBOT_ADAPTER=mock
MOCK_ROBOT_DELAY_MS=1500

# ── Task defaults ───────────────────────────────────────────────────────────────────────────────
# Max distance (meters) between final_object_position and target_position for success
POSITION_TOLERANCE_M=0.05
DEFAULT_REWARD_ETH=0.1
# Optional per-task reward cap (recommended on public deployments, e.g. 0.01)
MAX_REWARD_ETH=

# ── Settlement (Chainlink CRE) ──────────────────────────────────────────────────────────────────
# direct = the backend's verifier key commits proofs and settles (local fallback, no CRE account needed)
# cre    = the Chainlink CRE workflow (cre/machineproof-settlement) verifies and settles on-chain;
#          requires `npm run cre:deploy` and a running simulator (`npm run cre:simulate`)
SETTLEMENT_MODE=direct
# HTTP trigger of the workflow (`cre workflow simulate --listen` serves it on port 2000)
CRE_TRIGGER_URL=http://127.0.0.1:2000/trigger
# Mark a CRE settlement as timed out (retry with POST /tasks/:id/settle) after this long
CRE_SETTLEMENT_TIMEOUT_MS=120000
# Backend URL written into the workflow config by `npm run cre:deploy` (default http://127.0.0.1:$PORT)
CRE_BACKEND_URL=
