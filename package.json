{
  "name": "machineproof",
  "version": "0.1.0",
  "private": true,
  "description": "MachineProof: verifiable machine task execution with on-chain proof commitment and escrow settlement",
  "license": "MIT",
  "scripts": {
    "compile": "hardhat compile",
    "typecheck": "hardhat compile && tsc --noEmit",
    "test": "hardhat test",
    "chain": "hardhat node",
    "deploy": "hardhat compile && tsx scripts/deploy.ts",
    "dev": "tsx src/server.ts",
    "start": "tsx src/server.ts",
    "demo": "hardhat compile --quiet && tsx scripts/demo.ts",
    "robot:submit": "tsx scripts/robot-submit.ts"
  },
  "dependencies": {
    "dotenv": "^16.6.1",
    "ethers": "^6.17.0",
    "express": "^5.2.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-chai-matchers": "^2.1.2",
    "@nomicfoundation/hardhat-ethers": "^3.1.3",
    "@nomicfoundation/hardhat-network-helpers": "^1.1.2",
    "@openzeppelin/contracts": "^5.6.1",
    "@typechain/ethers-v6": "^0.5.1",
    "@typechain/hardhat": "^9.1.0",
    "@types/chai": "^4.3.20",
    "@types/express": "^5.0.6",
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.19.1",
    "chai": "^4.5.0",
    "hardhat": "^2.29.1",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.15",
    "typechain": "^8.3.2",
    "typescript": "~5.9.3"
  }
}
