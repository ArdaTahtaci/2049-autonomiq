{
  "name": "machineproof",
  "version": "0.1.0",
  "private": true,
  "description": "MachineProof: verifiable machine task execution with on-chain proof commitment and escrow settlement",
  "license": "MIT",
  "scripts": {
    "compile": "hardhat compile",
    "build": "hardhat compile --quiet && tsc -p tsconfig.build.json",
    "typecheck": "hardhat compile && tsc --noEmit",
    "test": "hardhat test",
    "test:workflow": "cd cre/machineproof-settlement && bun test",
    "test:all": "npm test && npm run test:workflow",
    "chain": "hardhat node",
    "deploy": "hardhat compile && tsx scripts/deploy.ts",
    "deploy:sepolia": "test -f .env.sepolia || { echo 'Missing .env.sepolia (see README → Deploying to Render)'; exit 1; } && hardhat compile && DOTENV_CONFIG_PATH=.env.sepolia tsx scripts/deploy.ts",
    "dev": "tsx src/server.ts",
    "dev:cre": "SETTLEMENT_MODE=cre tsx src/server.ts",
    "dev:sepolia": "test -f .env.sepolia || { echo 'Missing .env.sepolia (see README → Deploying to Render)'; exit 1; } && DOTENV_CONFIG_PATH=.env.sepolia tsx src/server.ts",
    "start": "node dist/src/server.js",
    "demo": "hardhat compile --quiet && tsx scripts/demo.ts",
    "demo:cre": "hardhat compile --quiet && tsx scripts/demo-cre.ts",
    "demo:sim": "hardhat compile --quiet && tsx scripts/demo-sim.ts",
    "demo:sim:cre": "hardhat compile --quiet && tsx scripts/demo-sim.ts --cre",
    "cre:install": "cd cre/machineproof-settlement && bun install",
    "cre:deploy": "hardhat compile --quiet && tsx scripts/cre-deploy.ts",
    "cre:simulate": "tsx scripts/cre-simulate.ts",
    "robot:submit": "tsx scripts/robot-submit.ts",
    "robot:sim": "robotics/.venv/bin/python robotics/backend_bridge.py",
    "test:cre-live": "cd cre/machineproof-settlement && bun run test:live",
    "cre:build": "tsx scripts/cre.ts workflow build ./machineproof-settlement -T local-simulation",
    "cre": "tsx scripts/cre.ts"
  },
  "dependencies": {
    "dotenv": "^16.6.1",
    "ethers": "^6.17.0",
    "express": "^5.2.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-chai-matchers": "^2.1.2",
    "@nomicfoundation/hardhat-ethers": "^3.1.3",
    "@nomicfoundation/hardhat-network-helpers": "^1.1.2",
    "@openzeppelin/contracts": "^5.6.1",
    "@typechain/ethers-v6": "^0.5.1",
    "@typechain/hardhat": "^9.1.0",
    "@types/chai": "^4.3.20",
    "@types/express": "^5.0.6",
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.19.1",
    "chai": "^4.5.0",
    "hardhat": "^2.29.1",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.15",
    "typechain": "^8.3.2",
    "typescript": "~5.9.3"
  },
  "engines": {
    "node": ">=20"
  }
}
